# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=5001

# MongoDB connection string (local, or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/SyncNode

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Browser origin(s) allowed by CORS. In production set your Vercel URL, e.g.
# https://your-app.vercel.app  (several can be comma-separated, no trailing slash needed)
FRONTEND_URL=http://localhost:5173
